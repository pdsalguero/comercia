# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Anthropic (IA para publicaciones)
ANTHROPIC_API_KEY=sk-ant-...

# MercadoPago
MP_PUBLIC_KEY=APP_USR-...
MP_ACCESS_TOKEN=APP_USR-...

# App URL
NEXT_PUBLIC_APP_URL=https://comerxia.com.ar

# AWS SES (Email transaccional)
AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=wJal...
AWS_SES_FROM_EMAIL=noreply@comerxia.com.ar

# Sentry (Monitoreo de errores)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=comerxia
SENTRY_PROJECT=javascript-nextjs

# Email soporte (Gmail SMTP - formulario de contacto)
GMAIL_USER=hola@comerxia.com.ar
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Coming soon mode (desactivar para mostrar el marketplace)
# COMING_SOON=true
